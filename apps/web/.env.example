API_INTERNAL_URL=http://localhost:4000

NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=

REVALIDATE_SECRET=
