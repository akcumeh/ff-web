{
  "name": "frankie-fabrics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "npm run build -w @ff/shared",
    "build": "npm run build -w @ff/shared && npm run build -w @ff/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @ff/web",
    "dev:api": "npm run dev -w @ff/api",
    "add-admin": "node --env-file=apps/api/.env scripts/add-admin.ts",
    "reset-mfa": "node --env-file=apps/api/.env scripts/reset-mfa.ts"
  },
  "devDependencies": {
    "supabase": "^3.2.0",
    "typescript": "^7.0.2"
  }
}
